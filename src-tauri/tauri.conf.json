{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMAN",
  "version": "2.0.0",
  "identifier": "com.almakhlafi.aman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "أمان - الخزنة الرقمية المحلية",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "ar-SA"
      }
    },
    "shortDescription": "خزنة أمان الرقمية المحلية لسطح مكتب ويندوز",
    "longDescription": "تطبيق خزنة مشفرة محلياً بالكامل لحفظ كلمات المرور، المفاتيح البرمجية، التراخيص، والبيانات الحساسة على أجهزة ويندوز دون اتصال بالإنترنت. تصميم : عبدالله المخلافي 2026",
    "copyright": "© 2026 عبدالله المخلافي. جميع الحقوق محفوظة."
  },
  "plugins": {
    "opener": {
      "openUrl": true
    }
  }
}
